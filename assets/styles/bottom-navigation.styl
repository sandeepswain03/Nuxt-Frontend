@import "variables.styl"

.bottom-navigation
  position fixed
  bottom 0
  left 0
  right 0
  background #fff
  border-top 1px solid #e5e7eb
  display flex
  justify-content space-around
  align-items center
  padding 8px 0
  z-index 1000
  box-shadow 0 -2px 8px rgba(0, 0, 0, 0.05)

  .nav-item
    display flex
    flex-direction column
    align-items center
    justify-content center
    gap 4px
    text-decoration none
    color #94a3b8
    transition all 0.3s ease
    padding 4px 8px
    min-width 60px
    flex 1

    .nav-icon
      width 24px
      height 24px
      opacity 0.6
      transition all 0.3s ease
      stroke currentColor
      fill none

    .nav-label
      font-size 12px
      font-weight 400
      line-height 1.2
      transition all 0.3s ease

    &.active
      color primary-color

      .nav-icon
        opacity 1
        stroke primary-color

      .nav-label
        color primary-color
        font-weight 500

    &:hover
      color primary-color

      .nav-icon
        opacity 1
        stroke primary-color

// Ensure main content has padding on mobile to account for bottom nav
@media only screen and (max-width: 768px)
  main
    padding-bottom 70px !important

// Hide on desktop
@media only screen and (min-width: 769px)
  .bottom-navigation
    display none !important

