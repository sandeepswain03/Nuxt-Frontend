@import "variables.styl"

.product-product-id
  .home-section
    .area-content
    .title
      padding-left 0
      padding-right 0

.detail-menu
  font-size .9em
  background #F1F2F3
  border-bottom 1px solid #eee

  a
    padding 0 15px
    line-height 40px

    &:hover
      background #fff

    &:active
      background #ddd

.product-detail
  .product-main
    flex-grow 1
    gap 15px
    display flex
    position relative

    .vouchers-wrapper
      .flex
        .card:last-child
          margin-bottom 0!important

    .detail-image-wrapper
      min-width 400px
      max-width 400px

      .detail-image-inner
        position sticky
        top 20px
        z-index 1

  .pricing-section
    .price-wrapper
      margin-bottom 8px

      .price
        font-size 1.8em
        font-weight 700
        color primary-color

      .strike-through
        font-size 1.2em
        margin-left 10px

    @media only screen and (max-width: 768px)
      margin-top 15px
      margin-bottom 15px

      .price-wrapper
        margin-bottom 8px
        display flex
        align-items center
        flex-wrap wrap
        gap 8px

        .price
          font-size 1.6em
          line-height 1.2

        .strike-through
          font-size 1.1em
          margin-left 0

      > div
        font-size 0.95em

  .action-section
    padding 20px 0
    border-bottom 1px solid #eee

    .flex.gap-10
      display flex
      gap 10px

      .flex-1
        flex 1
        min-width 0

    @media only screen and (max-width: 768px)
      padding 15px 0
      margin-top 15px
      margin-bottom 15px
      border-bottom none

      .start.flex.gap-10
        margin-bottom 15px
        align-items center

        .mn-w-70x
          min-width 70px
          font-size 0.95em
          margin-right 10px

      .flex.gap-10
        display flex
        flex-direction row
        gap 10px
        width 100%

        .flex-1
          flex 1
          min-width 0
          width auto

        .primary-btn,
        .outline-btn
          height 48px
          line-height 48px
          font-size 0.95em
          padding 0 15px
          font-weight 500

      .pos-rel.inline
        margin-top 12px
        margin-bottom 8px

        button
          font-size 0.9em
          padding 5px 0

      .f-9
        font-size 0.9em
        margin-top 8px

.suggested-container
  position relative
  transition all .2s
  max-height 10000px

  .review-list
  .rating-banner
  .total-rating
    opacity 0

  .suggested-wrapper
    position relative
    padding-left 365px

    .suggested-banner
      width 365px
      position absolute
      left 0
      top 0
      padding-right 30px

.suggested-container.mx-h-0
  min-height 0
  max-height 0
  overflow hidden

.suggested-container.review-loaded
  .review-list
  .rating-banner
  .total-rating
    opacity 1

.voucher-code
  margin-bottom 5px

.bundle-deal
  border-radius border-radius
  font-size .9em
  padding 4px 10px
  color primary-deep
  border 1px dashed primary-color

.product-detail
  .vouchers-wrapper
    min-height 200px
    .card
      flex-grow 1

.expanded
  max-height 100%!important

  &:after
    display none

.rtl .editor ul
  padding-left 0
  padding-right 2em


.editor
  li
    line-height 1.9
    list-style disc
    display list-item

  ul
    padding-left 2em
    list-style-type disc
    list-style-position inside

  ol
    padding-left 2em
    list-style-position inside
    list-style-type decimal

    li
      list-style decimal


//RESPONSIVE
@media only screen and (max-width: 1200px)
  .product-detail
    .product-main
      .detail-image-wrapper
        min-width 340px
        max-width 100%


@media only screen and (max-width: 992px)
  .product-detail
    .product-main
      flex-direction column

@media only screen and (max-width: 768px)
  .no-scroll .detail-image-inner
    z-index 2!important


  .detail-image-inner.z-2
    z-index 1 !important


  .product-detail
    .product-main
      padding-left 0

      .detail-image-wrapper
        width 100%
        min-width 0
        min-height 250px
        position static

        .slider-content-inner
          min-height 300px

@media only screen and (max-width: 576px)
  .product-main .two-sided .left
    width 90px
    min-width 90px
