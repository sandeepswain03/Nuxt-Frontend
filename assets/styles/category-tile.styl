.category-tile-wrapper
  display flex
  flex-wrap wrap
  margin 0 -10px

  .category-tile
    text-align center
    width 14.28%
    padding 0 10px
    margin-bottom 20px

    .img-wrapper
      img
        padding 15px

.category-card-link
  display block
  text-decoration none
  color inherit

.category-card
  padding 12px
  background #fff
  border-radius 16px
  border 1px solid #f1f5f9
  transition all 0.3s ease
  position relative
  height 100%
  display flex
  flex-direction column

  &:hover
    border-color primary-color

  // Pastel background colors - smooth and varied
  &.category-card-bg-0
    background #f0fdf4 // Light green

  &.category-card-bg-1
    background #fefce8 // Light yellow

  &.category-card-bg-2
    background #ecfdf5 // Light mint green

  &.category-card-bg-3
    background #fdf2f8 // Light pink

  &.category-card-bg-4
    background #fff7ed // Light orange

  &.category-card-bg-5
    background #faf5ff // Light purple

  &.category-card-bg-6
    background #f0f9ff // Light blue

  &.category-card-bg-7
    background #fef3c7 // Light amber

  &.category-card-bg-8
    background #fce7f3 // Light rose

  &.category-card-bg-9
    background #e0f2fe // Light sky blue

  .category-image-wrapper
    width 100%
    overflow hidden
    border-radius 8px
    height 96px

    @media (min-width: 1280px)
      height 128px

    @media (min-width: 1024px)
      height 96px

    @media (min-width: 768px)
      height 144px

    @media (min-width: 640px)
      height 144px

    .category-image
      width 100%
      height 100%
      object-fit contain
      transition transform 0.5s ease
      border-radius 8px

  &:hover .category-image-wrapper .category-image
    transform scale(1.1)

  .category-title
    text-align center
    color #64748b
    transition all 0.3s ease
    font-size 16px
    font-weight 500
    line-height normal
    margin-top 4px
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  &:hover .category-title
    color primary-color

//RESPONSIVE
@media only screen and (max-width: 1200px)
  .category-tile-wrapper
    .category-tile
      width 20%

@media only screen and (max-width: 992px)
  .category-tile-wrapper
    .category-tile
      width 25%
      margin-bottom 15px

@media only screen and (max-width: 768px)
  .category-tile-wrapper
    .category-tile
      width 33.33%

      .img-wrapper
        img
          padding 10px

  .category-card
    .category-image-wrapper
      height 96px

    .category-title
      font-size 14px

@media only screen and (max-width: 576px)
  .category-tile-wrapper
    margin 0

    .category-tile
      padding 0 5px
      width 50%
      margin-bottom 10px

  .category-card
    padding 8px

    .category-image-wrapper
      height 112px

    .category-title
      font-size 13px
      margin-top 2px
